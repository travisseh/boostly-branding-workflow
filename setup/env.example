# Boostly in-store branding workflow: per-user configuration.
# Installed by setup/setup.sh to ~/.config/boostly-branding/.env (mode 0600).
# Every value here is PERSONAL to the machine's operator. Never commit, paste into chat, or share.
# Lines are KEY=value with no spaces around "=". Leave a key empty until you have the value.

# ---------------------------------------------------------------- paths (required)
# Folder that holds one run directory per location (run.json, evidence/, variants/, review/, signage/).
# Agents use it as their working directory. Created by setup.sh.
BOOSTLY_RUN_ROOT=$HOME/boostly-branding/runs

# Shared heartbeat and ledger state (badge receipts, account write locks). Default: <run root>/heartbeat.
BOOSTLY_HEARTBEAT_ROOT=$HOME/boostly-branding/runs/heartbeat

# Chrome profile DIRECTORY name of the "Boostly.com" profile (the one signed in to new.boostly.com admin).
# Find it: ~/Library/Application Support/Google/Chrome/Local State -> profile.info_cache, the entry whose
# "name" is Boostly.com (looks like "Profile 3"). The cookie decrypt reads this profile's cookie jar.
BOOSTLY_CHROME_PROFILE=

# Boostly admin base URL. Leave the default.
BOOSTLY_BASE_URL=https://new.boostly.com

# Local clone of the Boostly app repo (github.com/Boostly/boostly) for the badge preview harness that the
# variant sheet renders through (PORT=3457 npm run dev, page from skills/boostly-brand-design/harness/dev-page).
BOOSTLY_REPO_DIR=$HOME/Programming/boostly

# ---------------------------------------------------------------- Boostly reads (required)
# Boostly admin MCP key for the operator's OWN admin user. new.boostly.com admin -> your profile -> MCP / API keys.
# Used two ways: `claude mcp add --transport http boostly-admin https://new.boostly.com/api/mcp --header "Authorization: Bearer <key>"`
# and by skills/v2-database/bin/v2-db, which routes read-only SQL through the MCP run_read_query tool.
BOOSTLY_ADMIN_MCP_KEY=
BOOSTLY_ADMIN_MCP_URL=https://new.boostly.com/api/mcp

# Optional: direct read-replica credentials (only if engineering issues a personal read-only DB user).
# When V2_DB_HOST is set, v2-db uses psql against the replica instead of the MCP path. Leave empty otherwise.
V2_DB_HOST=
V2_DB_PORT=5432
V2_DB_NAME=
V2_DB_USER=
V2_DB_PASSWORD=

# Signage planner (skills/boostly-signage-sheets/scripts/plan.mjs) reads the v2 signage endpoint with a
# service API key plus bearer. Travisse supplies both; same values as the brand-extractor service.
BOOSTLY_V2_API_BASE=https://new.boostly.com/api/service/v1
BOOSTLY_V2_API_KEY=

# ---------------------------------------------------------------- Slack (required for closeout posts)
# A user token (xoxp-...) for the operator's own Slack user so posts carry her name. api.slack.com/apps ->
# the Boostly "Claude Code" app (Travisse shares it) -> OAuth & Permissions -> User OAuth Token.
# Scopes needed: chat:write, files:write, channels:history, channels:read, users:read, search:read.
SLACK_USER_OAUTH_TOKEN=

# ---------------------------------------------------------------- Notion (required for the review queue)
# Internal integration token (ntn_... or secret_...). notion.so/my-integrations -> New integration in the
# Boostly workspace -> Internal Integration Secret. Then share these pages with the integration (... menu ->
# Connections): the Fulfillment Review Queue page and the Travisse AI Output database.
NOTION_API_TOKEN=
# Optional override of the wrapper script path (default ~/.config/notion-tools/notion-ai-ntn.sh, installed by setup.sh).
NOTION_WRAPPER=

# ---------------------------------------------------------------- evidence sources
# SearchAPI (GBP photo sets for the evidence packet). searchapi.io -> Dashboard -> API key.
SEARCHAPI_API_KEY=

# Google Places API (New) key for place details and photos. Boostly's GCP project key; Travisse supplies it.
GOOGLE_PLACES_API_KEY=

# DataForSEO (SERP search in link discovery). Boostly account login and password; Travisse supplies them.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# AskElephant (call transcripts for the preflight "call facts"). Optional: leave empty to skip transcripts.
# See skills/askelephant/SKILL.md for how the three values are obtained.
ASKELEPHANT_API_KEY=
ASKELEPHANT_REFRESH_TOKEN=
ASKELEPHANT_FIREBASE_API_KEY=

# ---------------------------------------------------------------- image tooling (optional)
# TinyPNG (logo byte-cap compression). tinypng.com/developers.
TINYPNG_API_KEY=
# Replicate (Real-ESRGAN upscale for small logo sources). replicate.com -> Account -> API tokens.
REPLICATE_API_TOKEN=
# OpenAI (image-generator skill: AI mockups and imagegen knockouts). platform.openai.com -> API keys.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------- print hand-off (customstickers.com)
# skills/boostly-print-handoff runs at closeout-finish: vector PDF export of the Figma print sheets, Drive upload,
# summary-sheet row, and a Gmail DRAFT to the vendor (never sent). Needs the three values below.
# Figma personal access token with file read access (figma.com -> Settings -> Security -> Personal access tokens).
FIGMA_TOKEN=
# Directory of the gmail-tools CLI (gmail.js). Not part of this repo: Travisse shares it separately. It must be
# authorized for the operator's own Boostly Google identity under the account name "boostly", and its `draft`
# command must accept --cc (build of 2026-10-12 or later). Drafts only; the skill has no send path.
GMAIL_TOOLS_DIR=$HOME/.config/gmail-tools
# Directory of google-tools (auth.js, the OAuth helper gmail-tools and the Drive upload share). Same source.
GOOGLE_TOOLS_DIR=$HOME/.config/google-tools

# ---------------------------------------------------------------- optional overrides (leave empty)
# Path to a minted admin cookie file; agents mint their own with decrypt-boostly-cookie.mjs, so leave empty.
BOOSTLY_COOKIE_FILE=
# Playwright module directory (default: skills/boostly-brand-design/harness/node_modules/playwright).
BOOSTLY_PLAYWRIGHT_MODULE=
# Codex CLI transport for link discovery (optional; the discovery-transport agent is the fallback).
BOOSTLY_CODEX_DISCOVER=
BOOSTLY_CODEX_BROWSER_CLIENT=
# Figma: no key. The Figma MCP plugin signs in through the browser (claude plugin install figma, then /mcp).
