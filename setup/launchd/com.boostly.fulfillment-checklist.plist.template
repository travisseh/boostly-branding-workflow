<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.boostly.fulfillment-checklist</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUN_ROOT__/checklist/launchd-refresh.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BOOSTLY_RUN_ROOT</key>
    <string>__RUN_ROOT__</string>
  </dict>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__RUN_ROOT__/checklist/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__RUN_ROOT__/checklist/launchd.log</string>
</dict>
</plist>
