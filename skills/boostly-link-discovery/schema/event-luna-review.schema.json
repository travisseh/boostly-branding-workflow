{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPT-5.6 Luna event timing review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "candidate_url",
    "evidence_hash",
    "verdict",
    "confidence",
    "reason",
    "events"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "model": { "type": "string", "const": "gpt-5.6-luna" },
    "candidate_url": { "type": "string", "pattern": "^https?://" },
    "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verdict": {
      "type": "string",
      "enum": ["upcoming_events_verified", "no_upcoming_events", "insufficient_evidence"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
    "events": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "date_text", "time_text", "recurrence_text", "normalized_start_date"],
        "properties": {
          "title": { "type": "string", "maxLength": 200 },
          "date_text": { "type": "string", "maxLength": 120 },
          "time_text": { "type": "string", "maxLength": 120 },
          "recurrence_text": { "type": "string", "maxLength": 200 },
          "normalized_start_date": {
            "anyOf": [
              { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  }
}
